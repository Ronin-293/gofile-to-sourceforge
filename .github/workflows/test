- name: Download ROM (Google Drive or Direct Link)
        run: |
          echo "Downloading..."

          RAW_URL="${{ github.event.inputs.gdrive_url }}"
          echo "Input URL: $RAW_URL"

          # Detect Google Drive link
          if echo "$RAW_URL" | grep -q "drive.google.com"; then
            echo "Detected Google Drive link"

            # Extract File ID
            FILE_ID=$(echo "$RAW_URL" | sed -E 's#.*/d/([^/]+).*#\1#')

            if [ "$FILE_ID" = "$RAW_URL" ]; then
              FILE_ID=$(echo "$RAW_URL" | sed -E 's/.*id=([^&]+).*/\1/')
            fi

            echo "Extracted File ID: $FILE_ID"

            if [ -z "$FILE_ID" ]; then
              echo "ERROR: Could not extract Google Drive File ID!"
              exit 1
            fi

            gdown "https://drive.google.com/uc?id=$FILE_ID&confirm=t" --fuzzy

          else
            echo "Detected Direct Mirror Link"

            # Get filename from URL
            FILE_NAME=$(basename "$RAW_URL")

            # Download using wget with resume support
            wget -c --content-disposition "$RAW_URL"

          fi

          echo "Downloaded files:"
          ls -lh

          FILE_NAME=$(ls *.zip | head -n 1 || true)

          if [ -z "$FILE_NAME" ]; then
            echo "ERROR: No ZIP file downloaded!"
            exit 1
          fi

          FILE_SIZE=$(stat -c%s "$FILE_NAME")
          echo "Downloaded size: $FILE_SIZE bytes"

          if [ "$FILE_SIZE" -lt 1073741824 ]; then
            echo "ERROR: File too small — likely wrong download!"
            exit 1
          fi

          echo "Detected file: $FILE_NAME"
          echo "FILE_NAME=$FILE_NAME" >> $GITHUB_ENV
